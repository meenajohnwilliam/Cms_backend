generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
  PENDING
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Tenant {
  tenantId  String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  subscription Subscription[]
  payments     Payment[]
  projects     Project[]
}

model User {
  userId          String  @id @default(cuid())
  name            String
  email           String  @unique
  password        String
  role            Role
  isEmailVerified Boolean @default(false)

  emailVerificationOtp          String?
  emailVerificationExpires      DateTime?
  emailVerificationOtpCreatedAt DateTime?

  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [tenantId])

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, role])
}

model Plan {
  planId String @id @default(cuid())
  name   String

  monthlyPrice String
  yearlyPrice  String

  razorpayMonthlyPlanId  String? @unique
  razorpayYearlyPlanId   String? @unique
  razorpaySubscriptionId String?

  projectLimit    Int
  collectionLimit Int
  apiKeyLimit     Int
  teamMemberLimit Int
  storageLimit    Int

  getRequestsLimit   Int
  writeRequestsLimit Int

  customDomain Boolean @default(false)
  mediaUpload  Boolean @default(false)

  analytics    String
  emailSupport String

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  isPopular    Boolean @default(false)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  subscriptionId String @id @default(cuid())

  tenantId String
  planId   String

  tenant Tenant @relation(fields: [tenantId], references: [tenantId])
  plan   Plan   @relation(fields: [planId], references: [planId])

  billingCycle BillingCycle
  status       SubscriptionStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime

  razorpaySubscriptionId String? @unique
  razorpayCustomerId     String?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([planId])
  @@index([tenantId, status])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  paymentId String @id @default(cuid())

  tenantId       String
  subscriptionId String

  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId])
  subscription Subscription @relation(fields: [subscriptionId], references: [subscriptionId])

  amount   String
  currency String        @default("INR")
  status   PaymentStatus @default(PENDING)

  razorpayPaymentId      String?   @unique
  razorpayOrderId        String?   @unique
  razorpaySubscriptionId String?
  paidAt                 DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
  RICHTEXT
  IMAGE
  FILE
  DATE
  JSON
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
}

model Project {
  projectId String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [tenantId])

  name        String
  slug        String
  description String?

  isActive Boolean @default(true)

  collections Collection[]
  apiKeys     ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Collection {
  collectionId String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  name String
  slug String

  status CollectionStatus @default(DRAFT)

  fields  CollectionField[]
  records Record[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([projectId])
}

model CollectionField {
  fieldId String @id @default(cuid())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [collectionId], onDelete: Cascade)

  name String
  slug String
  type FieldType

  isRequired   Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collectionId, slug])
  @@index([collectionId])
}

model Record {
  recordId String @id @default(cuid())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [collectionId], onDelete: Cascade)

  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collectionId])
}

model ApiKey {
  apiKeyId String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  name      String
  keyHash   String @unique
  keyPrefix String

  isActive   Boolean   @default(true)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}
