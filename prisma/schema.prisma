generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}



// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}


enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum PlanType {
  FREE
  PAID
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
  PENDING
}


enum BillingCycle {
  MONTHLY
  YEARLY
  NONE
}

enum FormFieldType {
  TEXT
  EMAIL
  NUMBER
  TEXTAREA
  SELECT
  MULTI_SELECT
  RADIO
  CHECKBOX
  DATE
  TIME
  DATETIME
  PHONE
  URL
  FILE
  IMAGE
}



model Tenant {
  tenantId        String   @id @default(cuid())
  name            String
  slug            String   @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users User[]
  subscription   Subscription[]
  payments        Payment[]
  projects        Project[]
  usage           Usage?

}


model User {
  userId          String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  role            Role
  isEmailVerified       Boolean  @default(false)


  emailVerificationOtp      String?
  emailVerificationExpires  DateTime?
  emailVerificationOtpCreatedAt DateTime?
  

  resetPasswordToken    String?  @unique
  resetPasswordExpires  DateTime?

  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [tenantId])

  projectAccess             UserProjectAccess[]

  lastLoginAt              DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, role])
}

model UserProjectAccess {
  accessId      String   @id @default(cuid())

  userId        String
  projectId     String

  user          User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  project       Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Plan {
  planId              String         @id @default(cuid())
  name                String         
  planType            PlanType       @default(PAID)
  billingCycle        BillingCycle   @default(NONE)
  price               String         @default("0")
  razorpayPlanId      String?        @unique

  projectLimit        Int
  collectionLimit     Int
  apiKeyLimit         Int
  teamMemberLimit     Int
  storageLimit        BigInt

  getRequestsLimit    Int
  writeRequestsLimit  Int

  customDomain        Boolean        @default(false)
  mediaUpload         Boolean        @default(false)

  analytics           String
  emailSupport        String

  displayOrder        Int            @default(0)
  isActive            Boolean        @default(true)
  isPopular           Boolean        @default(false)

  subscriptions       Subscription[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}


model Subscription {
  subscriptionId       String             @id @default(cuid())

  tenantId             String
  planId               String

  tenant               Tenant             @relation(fields: [tenantId], references: [tenantId])
  plan                 Plan               @relation(fields: [planId], references: [planId])

  billingCycle         BillingCycle
  status               SubscriptionStatus @default(ACTIVE)

  startDate            DateTime
  endDate              DateTime

  razorpaySubscriptionId  String?            @unique
  razorpayCustomerId      String?

   payments                Payment[]

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([tenantId])
  @@index([planId])
  @@index([tenantId, status])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  paymentId          String        @id @default(cuid())

  tenantId           String
  subscriptionId     String

  tenant             Tenant        @relation(fields: [tenantId], references: [tenantId])
  subscription       Subscription  @relation(fields: [subscriptionId], references: [subscriptionId])

  amount             String
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)

  razorpayPaymentId  String?       @unique
  razorpayOrderId    String?       @unique
  razorpaySubscriptionId String?      
  paidAt             DateTime?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
  RICHTEXT
  IMAGE
  FILE
  DATE
  JSON
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
}

model Project {
  projectId       String       @id @default(cuid())

  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [tenantId])

  name            String
  slug            String
  description     String?

  isActive        Boolean      @default(true)

  collections     Collection[]
  apiKeys         ApiKey[]
  userAccess      UserProjectAccess[]
  form            Form[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Collection {
  collectionId    String            @id @default(cuid())

  projectId       String
  project         Project           @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  name            String
  slug            String

  status          CollectionStatus  @default(DRAFT)

  fields          CollectionField[]
  records         Record[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([projectId, slug])
  @@index([projectId])
}

model CollectionField {
  fieldId         String      @id @default(cuid())

  collectionId    String
  collection      Collection  @relation(fields: [collectionId], references: [collectionId], onDelete: Cascade)

  name            String
  slug            String
  type            FieldType

  isRequired      Boolean     @default(false)
  displayOrder    Int         @default(0)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([collectionId, slug])
  @@index([collectionId])
}

model Record {
  recordId        String      @id @default(cuid())
  collectionId    String
  collection      Collection  @relation(fields: [collectionId], references: [collectionId], onDelete: Cascade)
  data            Json
  media           Media[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([collectionId])
}

model ApiKey {
  apiKeyId        String      @id @default(cuid())

  projectId       String
  project         Project     @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  name            String
  keyHash         String      @unique
  keyPrefix       String

  isActive        Boolean     @default(true)
  lastUsedAt      DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([projectId])
}

enum FormStatus {
  DRAFT
  PUBLISHED
}


model Form {
  formId          String           @id @default(cuid())

  projectId       String
  project         Project          @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  name            String
  slug            String
  description     String?

  status          FormStatus       @default(DRAFT)

  fields          FormField[]
  submissions     FormSubmission[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([projectId, slug])
  @@index([projectId])
}


model FormField {
  fieldId       String         @id @default(cuid())

  formId        String
  form          Form           @relation(fields: [formId], references: [formId], onDelete: Cascade)

  name          String
  label         String
  type          FormFieldType

  required      Boolean        @default(false)

  placeholder   String?
  options       Json?

  displayOrder  Int            @default(0)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([formId])
}


model FormSubmission {
  submissionId  String      @id @default(cuid())

  formId       String
  form         Form        @relation(fields: [formId], references: [formId], onDelete: Cascade)

  data         Json

  media        Media[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([formId])
  @@index([formId, createdAt])
}

model Media {
  mediaId       String   @id @default(cuid())

  recordId      String?
  record        Record?  @relation(fields: [recordId], references: [recordId], onDelete: Cascade)

  submissionId String?
  submission   FormSubmission? @relation(fields: [submissionId], references: [submissionId], onDelete: Cascade)

  fieldId       String?

  type          FieldType

  originalName  String
  fileName      String
  mimeType      String
  size          Int

  storageKey    String
  url           String

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([recordId])
  @@index([fieldId])
}


model Usage {
  usageId          String   @id @default(cuid())

  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  storageUsedBytes  BigInt  @default(0)

  getRequestsUsed   Int     @default(0)
  writeRequestsUsed Int     @default(0)

  apiKeysUsed      Int      @default(0)
  projectsUsed     Int      @default(0)
  collectionsUsed  Int      @default(0)
  teamMembersUsed  Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}