generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}



// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}


enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
}


enum BillingCycle {
  MONTHLY
  YEARLY
}



model Tenant {
  tenantId        String   @id @default(cuid())
  name            String
  slug            String   @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users User[]
  subscription   Subscription[]

}


model User {
  userId          String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  role            Role
  isEmailVerified       Boolean  @default(false)

  emailVerificationOtp      String?
  emailVerificationExpires  DateTime?

  resetPasswordToken    String?  @unique
  resetPasswordExpires  DateTime?

  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [tenantId])

  lastLoginAt              DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, role])
}

model Plan {
  planId              String         @id @default(cuid())
  name                String         @unique

  monthlyPrice        String
  yearlyPrice         String

  projectLimit        Int
  collectionLimit     Int
  apiKeyLimit         Int
  teamMemberLimit     Int
  storageLimit        Int

  getRequestsLimit    Int
  writeRequestsLimit  Int

  customDomain        Boolean        @default(false)
  mediaUpload         Boolean        @default(false)

  analytics           String
  emailSupport        String

  displayOrder        Int            @default(0)
  isActive             Boolean        @default(true)
  isPopular            Boolean        @default(false)

  subscriptions       Subscription[]

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}


model Subscription {
  subscriptionId       String             @id @default(cuid())

  tenantId             String
  planId               String

  tenant               Tenant             @relation(fields: [tenantId], references: [tenantId])
  plan                 Plan               @relation(fields: [planId], references: [planId])

  billingCycle         BillingCycle
  status               SubscriptionStatus @default(ACTIVE)

  startDate            DateTime
  endDate              DateTime

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([tenantId])
  @@index([planId])
  @@index([tenantId, status])
}



